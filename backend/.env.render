# CircleUp Backend - Render Environment Variables
# Upload this file using "Add from .env" on Render dashboard

# JWT Auth
JWT_SECRET=change-this-to-a-long-random-secret-string-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth (optional - needed for Google login)
GOOGLE_CLIENT_ID=your-google-client-id-here

# AWS S3 (optional - needed for image uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-south-1

# DATABASE_URL is auto-injected by Render from the PostgreSQL service
# Do NOT add it manually here
